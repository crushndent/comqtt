# Django Settings
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,django
DJANGO_LOG_LEVEL=INFO

# Database Settings (used by both Django and CoMQTT)
DB_NAME=mqtt_db
DB_USER=mqtt_db_user
DB_PASSWORD=mqtt_db_password
DB_HOST=postgres
DB_PORT=5432

# MQTT Broker Settings
MQTT_TCP_PORT=1883
MQTT_WS_PORT=1882
MQTT_HTTP_PORT=8080

# Redis Settings (optional, for caching and session storage)
REDIS_HOST=redis
REDIS_PORT=6379
